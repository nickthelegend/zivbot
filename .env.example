# FalkorDB — local Docker by default (docker compose up -d falkordb)
FALKORDB_URL=redis://localhost:6379
# Optional: any OpenAI-compatible chat endpoint with tool calling.
# Without these ZivBot runs its built-in graph planner (no LLM needed).
ZIV_LLM_BASE_URL=https://openrouter.ai/api/v1
ZIV_LLM_API_KEY=
ZIV_LLM_MODEL=nvidia/nemotron-3-super-120b-a12b:free
# How often the dot scans the graph on its own (ms). 0 turns it off.
ZIV_PROACTIVE_MS=600000
PORT=8787
# Optional model pins for coding agents ZivBot dispatches
ZIV_CODEX_MODEL=
ZIV_OPENCODE_MODEL=opencode/big-pickle
# Optional: real embeddings for semantic memory (any OpenAI-compatible /embeddings endpoint).
# Without them ZivBot uses a local feature-hashing embedder (no network).
ZIV_EMBED_BASE_URL=
ZIV_EMBED_API_KEY=
ZIV_EMBED_MODEL=text-embedding-3-small

# Public web deploy: refuse local-path/process connectors, hand runs to desktop
# ZIV_HOSTED=1
# ZIV_CORS_ORIGINS=https://your-web.example
# VITE_API_BASE=https://your-api.example   (build-time, for the web app)
