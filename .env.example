# FalkorDB — local Docker by default (docker compose up -d falkordb)
FALKORDB_URL=redis://localhost:6379
# Optional: any OpenAI-compatible chat endpoint with tool calling.
# Without these ZivBot runs its built-in graph planner (no LLM needed).
ZIV_LLM_BASE_URL=https://openrouter.ai/api/v1
ZIV_LLM_API_KEY=
ZIV_LLM_MODEL=openai/gpt-4o-mini
# How often the dot scans the graph on its own (ms). 0 turns it off.
ZIV_PROACTIVE_MS=600000
PORT=8787
# Optional model pins for coding agents ZivBot dispatches
ZIV_CODEX_MODEL=
ZIV_OPENCODE_MODEL=opencode/big-pickle
