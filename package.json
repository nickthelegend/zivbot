{
  "name": "zivbot",
  "version": "0.1.0",
  "private": true,
  "description": "ZivBot — a personal agent that works on its own computer and thinks in a FalkorDB graph.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20.10"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c magenta,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch server/index.ts",
    "dev:web": "vite",
    "build": "vite build",
    "start": "tsx server/index.ts",
    "seed": "tsx server/cli/seed.ts",
    "mcp": "tsx server/mcp.ts",
    "typecheck": "tsc --noEmit -p .",
    "test": "tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@noble/ciphers": "^2.4.0",
    "@supabase/supabase-js": "^2.116.0",
    "d3-force": "^3.0.0",
    "falkordb": "^6.8.0",
    "hono": "^4.13.13",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/d3-force": "^3.0.10",
    "@types/node": "^26.6.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "qrcode": "^1.5.4",
    "simple-icons": "^16.35.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
